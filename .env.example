# Servidor
PORT=8080
NODE_ENV=development
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1d

# Base de datos
DATABASE_URL="postgresql://user:password@localhost:5432/tiktok_live_sales?schema=public"

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# WhatsApp - Meta Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Supabase Storage (comprobantes)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=comprobantes

# Frontend
FRONTEND_URL=http://localhost:3000

# BNB - Banco Nacional de Bolivia (verificación de pagos QR/transferencias)
BNB_API_BASE_URL=https://api.bnb.com.bo
BNB_API_KEY=
BNB_ACCOUNT_ID=
BNB_MERCHANT_ID=
