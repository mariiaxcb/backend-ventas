generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum StreamStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum OrderStatus {
  PENDING
  IN_REVIEW
  PAID
  REJECTED
  DELIVERED
  CANCELLED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum ReceiptStatus {
  PENDING
  VALIDATED
  REJECTED
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

enum GeneralStatus {
  ACTIVE
  INACTIVE
}

model Category {
  id       Int           @id @default(autoincrement())
  name     String        @unique @db.VarChar(100)
  status   GeneralStatus @default(ACTIVE)
  products Product[]
}

model Product {
  id                 Int                @id @default(autoincrement())
  name               String             @db.VarChar(150)
  price              Decimal            @db.Decimal(10, 2)
  stock              Int                @default(0)
  description        String?            @db.Text
  status             ProductStatus      @default(ACTIVE)
  imageUrl           String?            @db.Text
  categoryId         Int
  category           Category           @relation(fields: [categoryId], references: [id])
  orderItems         OrderItem[]
  inventoryHistories InventoryHistory[]
}

model InventoryHistory {
  id           Int          @id @default(autoincrement())
  quantity     Int
  createdAt    DateTime     @default(now())
  movementType MovementType
  productId    Int
  product      Product      @relation(fields: [productId], references: [id])
}

model Admin {
  id       Int           @id @default(autoincrement())
  username String        @unique @db.VarChar(50)
  password String        @db.VarChar(255)
  status   GeneralStatus @default(ACTIVE)
  streams  Stream[]
}

model Stream {
  id        Int          @id @default(autoincrement())
  startDate DateTime
  endDate   DateTime?
  title     String       @db.VarChar(150)
  status    StreamStatus @default(SCHEDULED)
  adminId   Int
  admin     Admin        @relation(fields: [adminId], references: [id])
  orders    Order[]
}

model Buyer {
  id             Int      @id @default(autoincrement())
  tiktokUsername String?  @db.VarChar(50)
  whatsapp       String   @db.VarChar(20)
  clientName     String   @db.VarChar(100)
  createdAt      DateTime @default(now())
  orders         Order[]
}

model Order {
  id            Int         @id @default(autoincrement())
  totalPrice    Decimal     @db.Decimal(10, 2)
  status        OrderStatus @default(PENDING)
  qrId          String?     @db.VarChar(100)
  transactionId String?     @db.VarChar(100)
  buyerId       Int
  buyer         Buyer       @relation(fields: [buyerId], references: [id])
  streamId      Int
  stream        Stream      @relation(fields: [streamId], references: [id])

  orderItems    OrderItem[]
  messages      Message[]
  receipt       Receipt?
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
}

model Message {
  id      Int           @id @default(autoincrement())
  content String        @db.Text
  status  MessageStatus @default(SENT)
  orderId Int
  order   Order         @relation(fields: [orderId], references: [id])
}

model Receipt {
  id               Int           @id @default(autoincrement())
  imageUrl         String        @db.VarChar(255)
  extractedAmount  Decimal?      @db.Decimal(10, 2)
  validationStatus ReceiptStatus @default(PENDING)
  orderId          Int           @unique
  order            Order         @relation(fields: [orderId], references: [id])
}